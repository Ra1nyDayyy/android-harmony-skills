{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Phase 4 page acceptance contract",
  "type": "object",
  "required": [
    "schema_version", "page_id", "page_name", "carrier_type", "feature_ids", "states", "components",
    "source_geometry", "assets", "visible_text", "interaction_bindings", "entry_conditions",
    "transitions", "code_map", "business_rules", "data_dependencies", "side_effects",
    "system_capabilities", "android_evidence_hashes", "phase3_targets", "required_h4env_ids",
    "comparison_policy", "gmi_fields", "gmi_options", "gmi_navigation", "gmi_motion",
    "behavior_bindings"
  ],
  "properties": {
    "schema_version": {"const": "page-acceptance-contract-v1"},
    "page_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "page_name": {"type": "string", "minLength": 1},
    "carrier_type": {"enum": ["PAGE", "DIALOG", "SHEET", "POPUP", "WIDGET"]},
    "feature_ids": {"$ref": "#/$defs/idArray"},
    "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "source_geometry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometry"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "visible_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interaction_bindings": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "entry_conditions": {"type": "array", "items": {"$ref": "#/$defs/entryCondition"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "code_map": {"type": "array", "items": {"$ref": "#/$defs/codeMap"}},
    "business_rules": {"type": "array", "items": {"$ref": "#/$defs/businessRule"}},
    "data_dependencies": {"type": "array", "items": {"$ref": "#/$defs/dataDependency"}},
    "side_effects": {"type": "array", "items": {"$ref": "#/$defs/sideEffect"}},
    "system_capabilities": {"type": "array", "items": {"$ref": "#/$defs/systemCapability"}},
    "android_evidence_hashes": {"type": "array", "items": {"$ref": "#/$defs/androidEvidence"}},
    "phase3_targets": {"type": "array", "items": {"$ref": "#/$defs/phase3Target"}},
    "required_h4env_ids": {"$ref": "#/$defs/idArray"},
    "gmi_fields": {"type": "array", "items": {"type": "object"}},
    "gmi_options": {"type": "array", "items": {"type": "object"}},
    "gmi_navigation": {"type": "array", "items": {"type": "object"}},
    "gmi_motion": {"type": "array", "items": {"type": "object"}},
    "behavior_bindings": {"type": "array", "items": {"type": "object"}},
    "comparison_policy": {
      "type": "object",
      "required": ["geometry_tolerance", "application_region_ssim", "changed_pixel_ratio", "required_element_masks"],
      "properties": {
        "geometry_tolerance": {"const": "max(2dp, 0.5%)"},
        "application_region_ssim": {"const": 0.98},
        "changed_pixel_ratio": {"const": 0.02},
        "required_element_masks": {"const": "STRICTER_REQUIRED_ELEMENT_MASKS"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "idArray": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "geometry": {
      "anyOf": [
        {"type": "object", "minProperties": 1, "additionalProperties": true},
        {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1, "additionalProperties": true}}
      ]
    },
    "sourceRecord": {"type": "object", "additionalProperties": true},
    "component": {
      "allOf": [
        {"$ref": "#/$defs/sourceRecord"},
        {"required": ["component_id", "page_id"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "page_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "interaction": {
      "allOf": [
        {"$ref": "#/$defs/sourceRecord"},
        {"required": ["event_id", "page_id"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "page_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "transition": {
      "allOf": [
        {"$ref": "#/$defs/sourceRecord"},
        {"required": ["transition_id", "source_page_id", "target_page_id"], "properties": {"transition_id": {"$ref": "#/$defs/id"}, "source_page_id": {"$ref": "#/$defs/id"}, "target_page_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "codeMap": {
      "allOf": [
        {"$ref": "#/$defs/sourceRecord"},
        {"required": ["code_ref", "page_id"], "properties": {"code_ref": {"$ref": "#/$defs/id"}, "page_id": {"$ref": "#/$defs/id"}}}
      ]
    },
    "businessRule": {"allOf": [{"$ref": "#/$defs/sourceRecord"}, {"required": ["business_rule_id"], "properties": {"business_rule_id": {"$ref": "#/$defs/id"}}}]},
    "dataDependency": {"allOf": [{"$ref": "#/$defs/sourceRecord"}, {"required": ["data_dependency_id"], "properties": {"data_dependency_id": {"$ref": "#/$defs/id"}}}]},
    "sideEffect": {"allOf": [{"$ref": "#/$defs/sourceRecord"}, {"required": ["side_effect_id"], "properties": {"side_effect_id": {"$ref": "#/$defs/id"}}}]},
    "systemCapability": {"allOf": [{"$ref": "#/$defs/sourceRecord"}, {"required": ["system_capability_id"], "properties": {"system_capability_id": {"$ref": "#/$defs/id"}}}]},
    "asset": {"allOf": [{"$ref": "#/$defs/sourceRecord"}, {"required": ["asset_id"], "properties": {"asset_id": {"$ref": "#/$defs/id"}}}]},
    "entryCondition": {
      "type": "object",
      "required": ["state_id", "entry_condition", "action_summary"],
      "properties": {"state_id": {"$ref": "#/$defs/id"}, "entry_condition": {"type": "string", "minLength": 1}, "action_summary": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "androidEvidence": {
      "type": "object",
      "required": ["evidence_id", "relative_path", "screenshot_sha256", "layout_sha256", "metadata_sha256", "source_geometry"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "relative_path": {"type": "string", "minLength": 1},
        "screenshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "layout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_geometry": {"$ref": "#/$defs/geometry"}
      },
      "additionalProperties": false
    },
    "stateRecord": {
      "type": "object",
      "required": ["inventory_id", "feature_id", "env_id", "entry_condition", "action_summary", "expected_observable", "android_evidence", "business_rule_ids", "data_dependency_ids", "system_capability_ids"],
      "properties": {
        "inventory_id": {"$ref": "#/$defs/id"}, "feature_id": {"$ref": "#/$defs/id"}, "env_id": {"$ref": "#/$defs/id"},
        "entry_condition": {"type": "string", "minLength": 1}, "action_summary": {"type": "string", "minLength": 1}, "expected_observable": {"type": "string", "minLength": 1},
        "android_evidence": {"$ref": "#/$defs/androidEvidence"}, "business_rule_ids": {"$ref": "#/$defs/idArray"}, "data_dependency_ids": {"$ref": "#/$defs/idArray"}, "system_capability_ids": {"$ref": "#/$defs/idArray"}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["state_id", "state_name", "records"],
      "properties": {"state_id": {"$ref": "#/$defs/id"}, "state_name": {"type": "string", "minLength": 1}, "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateRecord"}}},
      "additionalProperties": false
    },
    "phase3Target": {
      "type": "object",
      "required": ["state_id", "env_id", "harmony_module_id", "target_kind", "target_id"],
      "properties": {"state_id": {"$ref": "#/$defs/id"}, "env_id": {"$ref": "#/$defs/id"}, "harmony_module_id": {"$ref": "#/$defs/id"}, "target_kind": {"$ref": "#/$defs/id"}, "target_id": {"$ref": "#/$defs/id"}},
      "additionalProperties": false
    }
  }
}
