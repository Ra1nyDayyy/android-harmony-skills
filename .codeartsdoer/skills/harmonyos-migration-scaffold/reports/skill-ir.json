  "title": "HarmonyOS Migration Scaffold",
  "job_to_be_done": "Build and verify a non-business HarmonyOS NEXT project scaffold from a frozen Android migration inventory, with immutable inputs and environments, real module and route landing points, interface-only capability contracts, frozen-emulator PNG evidence, command-line build proof, and an independent Phase 3 gate. Use after the Android inventory phase passes; do not use it to implement business behavior or alter Phase 2 artifacts.",
  "trigger_surface": {
    "description": "Build and verify a non-business HarmonyOS NEXT project scaffold from a frozen Android migration inventory, with immutable inputs and environments, real module and route landing points, interface-only capability contracts, frozen-emulator PNG evidence, command-line build proof, and an independent Phase 3 gate. Use after the Android inventory phase passes; do not use it to implement business behavior or alter Phase 2 artifacts.",
    "should_trigger": [
      "阶段2已经通过，用内置模板生成可运行的鸿蒙基座。",
      "建立 ArkUI 模块、路由落点、公共 UI 和能力接口，但不要写业务。",
      "验证鸿蒙基座能编译、安装、启动并打开所有页面壳。"
    ],
    "should_not_trigger": [
      "分析 Android 项目的页面和功能。",
      "实现计算器运算逻辑并做到视觉一致。",
      "执行阶段1到4的完整迁移。"
    ],
    "edge_cases": [
      "创建一个完全空白的普通鸿蒙示例项目。",
      "修改已有鸿蒙应用的导航架构。",
      "把 Android 页面直接改造成鸿蒙 Dialog。"
    ]
  },
  "workflow": {
    "steps": [
      "Verify Gates 1-2 and hash-lock the complete Phase 2 handoff and Phase 3 work order.",
      "Generate the HarmonyOS project only from the bundled ArkUI Stage template and freeze toolchain provenance.",
      "Assign every inventory record, asset, dynamic obligation, route, surface, and capability to a real project landing point.",
      "Build only route/surface shells, public UI foundations, and interface-only contracts with no business behavior.",
      "Run frozen build/install/launch/smoke/screenshot commands, seal HENV/HVER, and close with independent Gate 3 acceptance."
    ],
    "decision_points": [
      "An Android route remains a route and a non-route visual surface remains a surface shell.",
      "Business behavior, fake data, state logic, and real adapters are rejected from Phase 3.",
      "Any Phase 2 drift or missing advanced obligation returns upstream instead of being simplified."
    ],
    "failure_modes": [
      "The model silently drops routes, surfaces, assets, or advanced obligations.",
      "A generic sample project replaces the frozen template or input mapping.",
      "A fake executable, self-declared result, hand-written PNG, or invalid HAP is accepted as runtime proof.",
      "Gate 3 is confused with authorization to implement business features."
    ]
  },
