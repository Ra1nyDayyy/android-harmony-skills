{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Android migration evidence metadata",
  "type": "object",
  "required": [
    "evidence_id", "inventory_id", "feature_id", "page_id", "state_id", "env_id",
    "issued_by", "issued_at", "captured_by", "captured_at", "capture_tool",
    "android_cli_version", "device_serial", "commands", "artifacts", "status",
    "environment_registry_sha256", "environment_attestation_sha256", "scope_sha256", "device_verification", "environment_verification",
    "application_verification", "source_verification"
  ],
  "properties": {
    "evidence_id": {"type": "string"},
    "inventory_id": {"type": "string"},
    "feature_id": {"type": "string"},
    "page_id": {"type": "string"},
    "state_id": {"type": "string"},
    "env_id": {"type": "string"},
    "issued_by": {"type": "string"},
    "issued_at": {"type": "string"},
    "captured_by": {"type": "string"},
    "captured_at": {"type": "string"},
    "capture_tool": {"const": "android-cli"},
    "android_cli_version": {"type": "string"},
    "device_serial": {"type": "string"},
    "application_id": {"type": "string"},
    "app_version": {"type": "string"},
    "app_build": {"type": "string"},
    "source_revision": {"type": "string"},
    "apk_sha256": {"type": "string"},
    "environment_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_evidence_id": {"type": "string"},
    "supersedes_evidence_id": {"type": "string"},
    "commands": {"type": "array", "minItems": 3},
    "device_verification": {"type": "object"},
    "environment_verification": {"type": "array", "minItems": 9, "maxItems": 9},
    "application_verification": {"type": "object"},
    "source_verification": {"type": "array", "minItems": 2, "maxItems": 2},
    "artifacts": {"type": "array", "minItems": 3},
    "status": {"const": "SEALED"}
  },
  "additionalProperties": true
}
